<Window x:Class="ProtopteraPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protoptera Player"
        Icon="Assets/icon.ico"
        Width="480" Height="196"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Палитра бренд-пака: чернила / янтарь / кость -->
        <Color x:Key="InkColor">#0A0A09</Color>
        <Color x:Key="AmberColor">#FFAA1D</Color>
        <Color x:Key="BoneColor">#F4F1E8</Color>

        <SolidColorBrush x:Key="BgBrush"      Color="{StaticResource InkColor}"/>
        <SolidColorBrush x:Key="InkBrush"     Color="{StaticResource InkColor}"/>
        <SolidColorBrush x:Key="TextBrush"    Color="{StaticResource BoneColor}"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="{StaticResource AmberColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFBC4A"/>
        <SolidColorBrush x:Key="MutedBrush"   Color="#8C877B"/>
        <SolidColorBrush x:Key="EdgeBrush"    Color="#2A2720"/>
        <SolidColorBrush x:Key="TrackBrush"   Color="#26231D"/>
        <SolidColorBrush x:Key="HoverBrush"   Color="#1F1D18"/>
        <SolidColorBrush x:Key="CoverBgBrush" Color="#14130F"/>

        <FontFamily x:Key="BrandFont">Bahnschrift, Segoe UI</FontFamily>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Главная кнопка: янтарный диск, чёрный глиф -->
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="disc" Fill="{StaticResource AccentBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="disc" Property="Fill" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource EdgeBrush}"
            BorderThickness="1" CornerRadius="12">
        <Grid>
            <!-- Водяной знак: когти в правом нижнем углу -->
            <Image Source="Assets/claws-bone.png" Width="150" Opacity="0.035"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-18,-34"
                   IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель: перетаскивание + пин / свернуть / закрыть -->
                <Grid Grid.Row="0" x:Name="TopBar" Background="Transparent" Height="32"
                      MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Image Source="Assets/claws-amber.png" Height="13" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="PROTOPTERA" FontFamily="{StaticResource BrandFont}" FontWeight="Bold"
                                   FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="PLAYER" FontFamily="{StaticResource BrandFont}" FontWeight="Light"
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <Button x:Name="PinButton" Style="{StaticResource Flat}" Width="30" Height="24"
                                Click="PinButton_Click" ToolTip="Поверх всех окон (вкл/выкл)">
                            <Grid Width="12" Height="13">
                                <Ellipse x:Name="PinHead" Width="7" Height="7" Fill="{StaticResource MutedBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                <Rectangle x:Name="PinNeedle" Width="1.6" Height="6" Fill="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Flat}" Width="30" Height="24" Click="Minimize_Click" ToolTip="Свернуть">
                            <Rectangle Width="10" Height="1.6" Fill="{StaticResource MutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource Flat}" Width="30" Height="24" Click="Close_Click" ToolTip="Закрыть">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Контент: слева обложка, справа управление -->
                <Grid Grid.Row="1" Margin="16,2,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Обложка -->
                    <Grid Grid.Column="0" Width="128" Height="128" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border CornerRadius="8" Background="{StaticResource CoverBgBrush}"/>
                        <!-- Плейсхолдер, когда обложки нет: узор «когти» + ледоруб -->
                        <Grid x:Name="CoverPlaceholder">
                            <Border CornerRadius="8" Opacity="0.14">
                                <Border.Background>
                                    <ImageBrush ImageSource="Assets/pattern-claws.png" TileMode="Tile"
                                                Viewport="0,0,42,42" ViewportUnits="Absolute"/>
                                </Border.Background>
                            </Border>
                            <Image Source="Assets/ledorub-amber.png" Width="64" Height="64"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <Border x:Name="CoverBorder" CornerRadius="8"
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <Border.Background>
                                <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="8" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"/>
                    </Grid>

                    <!-- Управление -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TrackTitle" Grid.Row="0" Text="Перетащи сюда mp3, flac или wav"
                                   Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                        <!-- Исполнитель · Альбом (из тегов; скрыто, если тегов нет) -->
                        <TextBlock x:Name="TrackSubtitle" Grid.Row="1" Visibility="Collapsed"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                        <!-- Формат + параметры потока -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0" Height="16">
                            <Border x:Name="FormatBadge" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="5,0" Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock x:Name="FormatText" FontFamily="{StaticResource BrandFont}" FontWeight="SemiBold"
                                           FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="AudioInfo" FontFamily="{StaticResource BrandFont}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Полоса прогресса / перемотки (прозрачная подложка = удобная зона клика) -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="SeekTrack" Grid.Column="0" Height="16" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="SeekTrack_MouseDown"
                                  MouseMove="SeekTrack_MouseMove"
                                  MouseLeftButtonUp="SeekTrack_MouseUp">
                                <Border Height="4" CornerRadius="2" Background="{StaticResource TrackBrush}"/>
                                <Border x:Name="SeekFill" Width="0" Height="4" CornerRadius="2"
                                        Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                                <Ellipse x:Name="SeekThumb" Width="10" Height="10" Fill="{StaticResource TextBrush}"
                                         HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Hidden"/>
                            </Grid>
                            <TextBlock x:Name="TimeText" Grid.Column="1" Text="00:00 / 00:00"
                                       FontFamily="{StaticResource BrandFont}"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Кнопки: Stop / Play-Pause -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,4,0,0">
                            <Button x:Name="StopButton" Style="{StaticResource Flat}" Width="40" Height="40"
                                    Click="Stop_Click" ToolTip="Stop" Margin="0,0,14,0">
                                <Rectangle Width="11" Height="11" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{StaticResource TextBrush}"/>
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource Primary}" Width="44" Height="44"
                                    Click="PlayPause_Click" ToolTip="Play / Pause (пробел)">
                                <Grid>
                                    <Path x:Name="PlayIcon" Data="M0,0 L13,8 L0,16 Z" Fill="{StaticResource InkBrush}"
                                          Margin="3,0,0,0"/>
                                    <StackPanel x:Name="PauseIcon" Orientation="Horizontal" Visibility="Collapsed">
                                        <Rectangle Width="4" Height="14" Fill="{StaticResource InkBrush}" Margin="0,0,4,0"/>
                                        <Rectangle Width="4" Height="14" Fill="{StaticResource InkBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <!-- Симметрия с кнопкой Stop -->
                            <Border Width="40" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
